rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      allow create: if owner(uid)
        && request.resource.data.keys().hasAll(['name', 'email', 'ageConfirmed', 'researchOnlyAccepted', 'termsVersion', 'acceptedAt', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'email', 'ageConfirmed', 'researchOnlyAccepted', 'termsVersion', 'acceptedAt', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.ageConfirmed == true
        && request.resource.data.researchOnlyAccepted == true
        && request.resource.data.termsVersion == '2026-10-07'
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /orders/{orderId} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      // Prices, discounts, ownership, paid status and quantities are written
      // only by the authenticated server-side order service.
      allow create, update, delete: if false;
    }
    match /customerStats/{uid} {
      allow get: if owner(uid);
      allow list, create, update, delete: if false;
    }
    match /customerAddresses/{uid} {
      allow get, delete: if owner(uid);
      allow list: if false;
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasAll(['name','phone','street','apartment','city','state','zip'])
        && request.resource.data.keys().hasOnly(['name','phone','street','apartment','city','state','zip'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.name.size() >= 2
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && request.resource.data.phone.size() >= 2
        && request.resource.data.street is string
        && request.resource.data.street.size() <= 160
        && request.resource.data.street.size() >= 2
        && request.resource.data.apartment is string
        && request.resource.data.apartment.size() <= 80
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 80
        && request.resource.data.city.size() >= 2
        && request.resource.data.state is string
        && request.resource.data.state.size() <= 2
        && request.resource.data.state.size() >= 2
        && request.resource.data.zip is string
        && request.resource.data.zip.size() <= 10
        && request.resource.data.zip.size() >= 2
        && request.resource.data.state.matches('^[A-Z]{2}$')
        && request.resource.data.zip.matches('^[0-9]{5}(-[0-9]{4})?$');
    }
    // Catalog, promotions, config, affiliates, inventory and admin operations
    // are served by the backend. Customers cannot directly edit them.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
