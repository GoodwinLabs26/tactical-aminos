rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      allow create: if owner(uid)
        && request.resource.data.keys().hasAll(['name', 'email', 'ageConfirmed', 'researchOnlyAccepted', 'termsVersion', 'acceptedAt', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'email', 'ageConfirmed', 'researchOnlyAccepted', 'termsVersion', 'acceptedAt', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.ageConfirmed == true
        && request.resource.data.researchOnlyAccepted == true
        && request.resource.data.termsVersion == '2026-10-07'
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /orders/{orderId} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      // Prices, discounts, ownership, paid status and quantities are written
      // only by the authenticated server-side order service.
      allow create, update, delete: if false;
    }
    match /customerStats/{uid} {
      allow get: if owner(uid);
      allow list, create, update, delete: if false;
    }
    // Catalog, promotions, config, affiliates, inventory and admin operations
    // are served by the backend. Customers cannot directly edit them.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
